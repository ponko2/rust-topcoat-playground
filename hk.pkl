amends "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Builtins.pkl"

steps {
  ["cargo_clippy"] = Builtins.cargo_clippy
  ["cargo_fmt"] = Builtins.cargo_fmt
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["jactionlint"] = Builtins.jactionlint
  ["oxfmt"] = Builtins.oxfmt
  ["ryl"] = Builtins.ryl
  ["topcoat"] {
    glob = "**/*.rs"
    fix = new CommandSpec {
      command = new Command { argv = List("topcoat", "fmt", "{{files}}") }
      effect = "write"
    }
  }
}

hooks {
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
}
